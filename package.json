{
  "name": "bm-render",
  "version": "0.1.3",
  "description": "Render JSX-like node trees / HTML + CSS to PNG, JPEG, WebP, SVG, animations and PDF with a dependency-free Zig engine: WebAssembly in Node.js, browsers, Bun, Deno and edge runtimes such as Cloudflare Workers, and a native Node-API addon on Node.js through optional per-platform packages (automatic wasm fallback).",
  "keywords": [
    "og-image",
    "open-graph",
    "image-generation",
    "image-rendering",
    "html-to-image",
    "jsx-to-image",
    "css",
    "flexbox",
    "png",
    "svg",
    "pdf",
    "webp",
    "wasm",
    "webassembly",
    "zig",
    "satori",
    "satori-alternative",
    "vercel-og-alternative",
    "edge",
    "cloudflare-workers",
    "deno",
    "bun",
    "napi",
    "node-api",
    "native-addon"
  ],
  "license": "MIT",
  "author": "hunghg255",
  "homepage": "https://github.com/BM-Hospital/bm-render#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BM-Hospital/bm-render.git"
  },
  "bugs": {
    "url": "https://github.com/BM-Hospital/bm-render/issues"
  },
  "type": "module",
  "main": "./js/node.mjs",
  "module": "./js/index.mjs",
  "types": "./js/index.d.mts",
  "exports": {
    ".": {
      "types": "./js/index.d.mts",
      "workerd": "./js/index.mjs",
      "worker": "./js/index.mjs",
      "edge-light": "./js/index.mjs",
      "browser": "./js/index.mjs",
      "node": "./js/node.mjs",
      "default": "./js/index.mjs"
    },
    "./core": {
      "types": "./js/core.d.mts",
      "workerd": "./js/core.mjs",
      "worker": "./js/core.mjs",
      "edge-light": "./js/core.mjs",
      "browser": "./js/core.mjs",
      "node": "./js/node-core.mjs",
      "default": "./js/core.mjs"
    },
    "./standard": {
      "types": "./js/standard.d.mts",
      "workerd": "./js/standard.mjs",
      "worker": "./js/standard.mjs",
      "edge-light": "./js/standard.mjs",
      "browser": "./js/standard.mjs",
      "node": "./js/node-standard.mjs",
      "default": "./js/standard.mjs"
    },
    "./full": {
      "types": "./js/full.d.mts",
      "workerd": "./js/full.mjs",
      "worker": "./js/full.mjs",
      "edge-light": "./js/full.mjs",
      "browser": "./js/full.mjs",
      "node": "./js/node-full.mjs",
      "default": "./js/full.mjs"
    },
    "./native": {
      "types": "./js/native.d.mts",
      "default": "./js/node-native.mjs"
    },
    "./pdf": {
      "types": "./js/pdf.d.mts",
      "workerd": "./js/pdf.mjs",
      "worker": "./js/pdf.mjs",
      "edge-light": "./js/pdf.mjs",
      "browser": "./js/pdf.mjs",
      "node": "./js/node-pdf.mjs",
      "default": "./js/pdf.mjs"
    },
    "./woff": {
      "types": "./js/addons.d.mts",
      "default": "./js/addons.mjs"
    },
    "./wasm": {
      "types": "./js/wasm.d.mts",
      "default": "./js/bm_render.wasm"
    },
    "./wasm?module": {
      "types": "./js/wasm.d.mts",
      "default": "./js/bm_render.wasm?module"
    },
    "./core.wasm": {
      "types": "./js/wasm.d.mts",
      "default": "./js/bm_render.core.wasm"
    },
    "./core.wasm?module": {
      "types": "./js/wasm.d.mts",
      "default": "./js/bm_render.core.wasm?module"
    },
    "./standard.wasm": {
      "types": "./js/wasm.d.mts",
      "default": "./js/bm_render.standard.wasm"
    },
    "./standard.wasm?module": {
      "types": "./js/wasm.d.mts",
      "default": "./js/bm_render.standard.wasm?module"
    },
    "./full.wasm": {
      "types": "./js/wasm.d.mts",
      "default": "./js/bm_render.wasm"
    },
    "./full.wasm?module": {
      "types": "./js/wasm.d.mts",
      "default": "./js/bm_render.wasm?module"
    },
    "./pdf.wasm": {
      "types": "./js/wasm.d.mts",
      "default": "./js/bm_render.pdf.wasm"
    },
    "./pdf.wasm?module": {
      "types": "./js/wasm.d.mts",
      "default": "./js/bm_render.pdf.wasm?module"
    },
    "./woff.wasm": {
      "types": "./js/wasm.d.mts",
      "default": "./js/bm_woff.wasm"
    },
    "./woff.wasm?module": {
      "types": "./js/wasm.d.mts",
      "default": "./js/bm_woff.wasm?module"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./js/node.mjs",
    "./js/node-core.mjs",
    "./js/node-standard.mjs",
    "./js/node-full.mjs",
    "./js/node-pdf.mjs"
  ],
  "files": [
    "js/index.mjs",
    "js/index.d.mts",
    "js/engine.mjs",
    "js/worker-pool.mjs",
    "js/worker.mjs",
    "js/node.mjs",
    "js/native.mjs",
    "js/node-native.mjs",
    "js/wasm-file.mjs",
    "js/native.d.mts",
    "js/core.mjs",
    "js/core.d.mts",
    "js/node-core.mjs",
    "js/standard.mjs",
    "js/standard.d.mts",
    "js/node-standard.mjs",
    "js/full.mjs",
    "js/full.d.mts",
    "js/node-full.mjs",
    "js/pdf.mjs",
    "js/pdf-api.mjs",
    "js/pdf-resources.mjs",
    "js/pdf.d.mts",
    "js/pdf-types.d.mts",
    "js/node-pdf.mjs",
    "js/addons.mjs",
    "js/addons.d.mts",
    "js/wasm.d.mts",
    "js/bm_render.core.wasm",
    "js/bm_render.standard.wasm",
    "js/bm_render.wasm",
    "js/bm_render.pdf.wasm",
    "js/bm_woff.wasm",
    "js/build-manifest.json",
    "README.md",
    "README.vi.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:core": "node scripts/build.mjs --profile=core",
    "build:standard": "node scripts/build.mjs --profile=standard",
    "build:full": "node scripts/build.mjs --profile=full",
    "build:pdf": "node scripts/build.mjs --profile=pdf",
    "build:manifest": "node scripts/build.mjs --manifest",
    "verify": "node scripts/npm-platform-packages.mjs --check && node scripts/build.mjs --verify",
    "test": "node scripts/build.mjs --test",
    "test:js": "node scripts/js-abort-test.mjs",
    "test:workers": "node scripts/worker-test.mjs",
    "test:limits": "node scripts/limits-test.mjs",
    "test:pdf": "node scripts/pdf-test.mjs",
    "test:pdf:chunks": "node scripts/pdf-chunks-check.mjs",
    "test:pdf:takumi": "node scripts/pdf-compare.mjs",
    "test:pdf:takumi:fetch": "node scripts/fetch-takumi-tests.mjs",
    "test:takumi:verify": "node scripts/takumi-test-corpus.mjs",
    "pdf:setup": "node bench/pdf/setup.mjs",
    "pdf:validate": "node bench/pdf/validate.mjs",
    "pdf:visual": "node bench/pdf/visual.mjs",
    "pdf:bench": "node bench/pdf/bench.mjs",
    "pdf:bench:quick": "node bench/pdf/bench.mjs --quick",
    "pdf:bench:report": "node bench/pdf/report.mjs",
    "bench:native": "node bench/run-native.mjs",
    "bench:native:report": "node bench/native/report.mjs",
    "test:pack": "node scripts/pack-test.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build:npm": "node scripts/npm-platform-packages.mjs",
    "version:set": "node scripts/npm-platform-packages.mjs --set-version",
    "test:native": "node bench/native-tests.mjs",
    "playground": "node docs/playground-app/serve.mjs",
    "docs:prepare": "node docs/.vitepress/prepare.mjs",
    "docs:dev": "npm run docs:prepare && vitepress dev docs --port 5173",
    "docs:build": "npm run docs:prepare && vitepress build docs",
    "docs:preview": "vitepress preview docs --port 4173",
    "docs": "npm run docs:dev",
    "release:check": "node scripts/publish.mjs --check",
    "release": "node scripts/publish.mjs",
    "release:dry": "node scripts/publish.mjs --dry-run",
    "prepublishOnly": "node scripts/publish.mjs --prepublish"
  },
  "devDependencies": {
    "binaryen": "^132.0.0",
    "vitepress": "^1.6.4"
  },
  "optionalDependencies": {
    "@hunghg255/bm-render-win32-x64-msvc": "0.1.3",
    "@hunghg255/bm-render-win32-arm64-msvc": "0.1.3",
    "@hunghg255/bm-render-linux-x64-gnu": "0.1.3",
    "@hunghg255/bm-render-linux-x64-musl": "0.1.3",
    "@hunghg255/bm-render-linux-arm64-gnu": "0.1.3",
    "@hunghg255/bm-render-linux-arm64-musl": "0.1.3",
    "@hunghg255/bm-render-darwin-x64": "0.1.3",
    "@hunghg255/bm-render-darwin-arm64": "0.1.3"
  },
  "overrides": {
    "vite": "^7.3.8",
    "@vitejs/plugin-vue": "^6.0.11"
  }
}
